diff --git a/src/web_service/announce_room_json.cpp b/src/web_service/announce_room_json.cpp
index 219b93f74eb9cfa1cb9b71c4e6c5b6b65fde7b60..60fac5ca1b2f4afe89c64eb58e3f1928571225d2 100644
--- a/src/web_service/announce_room_json.cpp
+++ b/src/web_service/announce_room_json.cpp
@@ -4,6 +4,10 @@
 // SPDX-FileCopyrightText: Copyright 2017 Citra Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include <chrono>
+#include <future>
+#include <memory>
+#include <thread>
 #include "common/logging.h"
 #include "web_service/announce_room_json.h"
 #include "web_service/web_backend.h"
@@ -92,11 +96,28 @@ WebService::WebResult RoomJson::Register() {
     if (result.result_code != WebService::WebResult::Code::Success) {
         return result;
     }
-
-    auto reply_json = jacinth::json::read(result.returned_data);
-    room = reply_json;
-    room_id = reply_json.get("id");
-
+    // A proxy error page, an outage or an incomplete reply must not register the room with an
+    // empty id: report it like any other announce error.
+    if (result.returned_data.empty()) {
+        LOG_ERROR(WebService, "Registration response is empty");
+        return WebService::WebResult{WebService::WebResult::Code::WrongContent,
+                                     "Empty response from server", ""};
+    }
+    auto reply_json = jacinth::json::try_read(result.returned_data);
+    if (!reply_json) {
+        LOG_ERROR(WebService, "Registration response is not JSON: {}",
+                  reply_json.error().message());
+        return WebService::WebResult{WebService::WebResult::Code::WrongContent,
+                                     "Invalid JSON in response", ""};
+    }
+    auto id = reply_json->try_get<std::string>("id");
+    if (!id || id->empty()) {
+        LOG_ERROR(WebService, "Registration response missing 'id' field");
+        return WebService::WebResult{WebService::WebResult::Code::WrongContent,
+                                     "Missing room ID in response", ""};
+    }
+    room = reply_json.value();
+    room_id = std::move(id.value());
     return WebService::WebResult{WebService::WebResult::Code::Success, "", room.verify_uid};
 }
 
@@ -116,12 +137,25 @@ void RoomJson::Delete() {
     if (room_id.empty()) {
         LOG_ERROR(WebService, "Room must be registered to be deleted");
     } else {
-        // This jthread won't be destroyed until after the dtor has been ran
-        // Once the thread finishes it will stay resident on the vector -- destroyed and freed by dtor()
-        // this is still valid while in dtor, so... yeah
-        detached_tasks.emplace_back([this](std::stop_token stop_token) {
-            client.DeleteJson(fmt::format("/lobby/{}", room_id), "", false);
-        });
+        // The room waits for this request when it stops, and docker stop allows 10 seconds. The
+        // web client has no read timeout, so a slow lobby could hold the room past that: the
+        // request runs on its own thread with copies of what it needs, and the destructor waits
+        // for it only up to DeleteWait. A request still running then is dropped with the process.
+        auto done = std::make_shared<std::promise<void>>();
+        delete_done = done->get_future();
+        std::thread([host = host, username = username, token = token,
+                     path = fmt::format("/lobby/{}", room_id), done] {
+            Client delete_client(host, username, token);
+            delete_client.SetTimeout(std::chrono::seconds(3));
+            delete_client.DeleteJson(path, "", false);
+            done->set_value();
+        }).detach();
+    }
+}
+
+RoomJson::~RoomJson() {
+    if (delete_done.valid() && delete_done.wait_for(DeleteWait) == std::future_status::timeout) {
+        LOG_WARNING(WebService, "The lobby did not answer the unregistration in time");
     }
 }
 
