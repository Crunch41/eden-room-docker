+void Room::RoomImpl::NoteGamePacket(ENetPeer* client) {
+    const auto it = peer_snapshots.find(client);
+    if (it == peer_snapshots.end()) {
+        return;
+    }
+    PeerSnapshot& snapshot = it->second;
+    const auto now = std::chrono::steady_clock::now();
+    if (snapshot.last_packet) {
+        const auto gap = now - *snapshot.last_packet;
+        if (gap >= GapMinimum && gap <= GapMaximum) {
+            const bool held = snapshot.held_since_packet;
+            snapshot.Record([&](UplinkStats& stats) {
+                ++stats.gaps;
+                stats.gaps_unheld += held ? 0 : 1;
+                stats.gap_max_ms = (std::max)(stats.gap_max_ms, Milliseconds(gap));
+            });
+        }
+        snapshot.burst = gap < BurstSpacing ? snapshot.burst + 1 : 1;
+    } else {
+        snapshot.burst = 1;
+    }
+    snapshot.last_packet = now;
+    snapshot.held_since_packet = false;
+    snapshot.Record([&](UplinkStats& stats) {
+        ++stats.packets;
+        stats.burst_max = (std::max)(stats.burst_max, snapshot.burst);
+    });
+}
+
+void Room::RoomImpl::SampleUplinkHolds() {
+    if (peer_snapshots.empty()) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    for (auto& [peer, snapshot] : peer_snapshots) {
+        if (Held(peer)) {
+            if (!snapshot.hold_start) {
+                snapshot.hold_start = now;
+            } else if (now - *snapshot.hold_start >= HoldMinimum) {
+                // Not a fragmented packet still arriving: the gap this hold opens is the
+                // network's, not the member's.
+                snapshot.held_since_packet = true;
+            }
+        } else if (snapshot.hold_start) {
+            const auto hold = now - *snapshot.hold_start;
+            snapshot.hold_start.reset();
+            if (hold >= HoldMinimum) {
+                snapshot.Record([&](UplinkStats& stats) {
+                    ++stats.holds;
+                    stats.hold_ms += Milliseconds(hold);
+                    stats.hold_max_ms = (std::max)(stats.hold_max_ms, Milliseconds(hold));
+                });
+            }
+        }
+    }
+}
+
+void Room::RoomImpl::LogSessionStats(ENetPeer* client, const std::string& ip,
+                                     const std::string& nickname) const {
+    PeerSnapshot snapshot{};
+    std::string duration = "?s";
+    if (const auto it = peer_snapshots.find(client); it != peer_snapshots.end()) {
+        snapshot = it->second;
+        const auto secs = std::chrono::duration_cast<std::chrono::seconds>(
+                              std::chrono::steady_clock::now() - snapshot.join_time)
+                              .count();
+        duration = secs >= 60 ? fmt::format("{}m{}s", secs / 60, secs % 60)
+                              : fmt::format("{}s", secs);
+    }
+    LOG_INFO(Network,
+             "[{}] {} session join_rtt {}ms last_rtt {}ms peak_rtt {}ms {} duration {}", ip,
+             nickname, snapshot.join_rtt, snapshot.last_rtt, snapshot.peak_rtt,
+             snapshot.session.Describe(), duration);
+}
+
+void Room::RoomImpl::MaybeLogRelayDiagnostics() {
+    if (diag_interval_sec == 0) {
+        return;
+    }
+    const bool reliable_mode = (GetRelayMode().flags & ENET_PACKET_FLAG_RELIABLE) != 0;
+    const auto now = std::chrono::steady_clock::now();
+    if (!diag_started) {
+        diag_started = true;
+        diag_window_start = now;
+        LOG_INFO(Network,
+                 "DIAG boot mode={} ldn=reliable unknown_ip={} timeout_ms={}/{} ping_ms={} "
+                 "diag_interval_s={} budget_kbps={} "
+                 "(the room sees members' packets on their way to it, not the game, and in "
+                 "unreliable modes not the loss of its own packets to members)",
+                 GetRelayMode().name, UnknownIpFallbackEnabled() ? "broadcast" : "drop",
+                 peer_timeout_min_ms, peer_timeout_max_ms, ping_interval_ms, diag_interval_sec,
+                 relay_budget_bytes / 1024);
+    }
+    if (now - diag_window_start < std::chrono::seconds(diag_interval_sec)) {
+        return;
+    }
+    diag_window_start = now;
+
+    const RelayCounters& total = relay_counters;
+    const RelayCounters window = total - relay_counters_last;
+    relay_counters_last = total;
+    const bool game_active = window.proxy_packets > 0;
+
+    // Sample every member's RTT for this report and for its STAT line, and collect what each
+    // member's stream to the room did in this window.
+    u32 members_n = 0;
+    u32 rtt_min = 0;
+    u32 rtt_max = 0;
+    u64 rtt_sum = 0;
+    u32 rtt_var_max = 0;
+    UplinkStats all{};
+    const PeerSnapshot* most_held = nullptr;
+    const PeerSnapshot* most_unheld = nullptr;
+    std::vector<std::string> member_lines;
+    {
+        std::shared_lock lock(member_mutex);
+        members_n = static_cast<u32>(members.size());
+        for (const auto& member : members) {
+            const u32 rtt = member.peer->roundTripTime;
+            rtt_min = &member == &members.front() ? rtt : (std::min)(rtt_min, rtt);
+            rtt_max = (std::max)(rtt_max, rtt);
+            rtt_sum += rtt;
+            rtt_var_max = (std::max)(rtt_var_max, member.peer->roundTripTimeVariance);
+
+            const auto it = peer_snapshots.find(member.peer);
+            if (it == peer_snapshots.end()) {
+                continue;
+            }
+            auto& snapshot = it->second;
+            snapshot.last_rtt = rtt;
+            snapshot.peak_rtt = (std::max)(snapshot.peak_rtt, rtt);
+            const UplinkStats& stats = snapshot.window;
+            all.holds += stats.holds;
+            all.hold_ms += stats.hold_ms;
+            all.gaps += stats.gaps;
+            all.gaps_unheld += stats.gaps_unheld;
+            if (stats.holds > 0 && (!most_held || stats.hold_ms > most_held->window.hold_ms)) {
+                most_held = &snapshot;
+            }
+            if (stats.gaps_unheld > 0 &&
+                (!most_unheld || stats.gaps_unheld > most_unheld->window.gaps_unheld)) {
+                most_unheld = &snapshot;
+            }
+            if (game_active) {
+                // ENet's loss figure is the share of the room's sends it had to resend. In the
+                // unreliable modes only pings and control messages are resent, so it says
+                // nothing about game packets.
+                const std::string resend =
+                    reliable_mode
+                        ? fmt::format(" resend {:.2f}%", LossPercent(member.peer->packetLoss))
+                        : std::string{};
+                member_lines.push_back(fmt::format(
+                    "DIAG member [{}] {} rtt {}ms var {}ms {}{}", snapshot.ip, snapshot.nickname,
+                    rtt, member.peer->roundTripTimeVariance, stats.Describe(), resend));
+            }
+        }
+    }
+    const u32 rtt_avg = members_n > 0 ? static_cast<u32>(rtt_sum / members_n) : 0;
+
+    LOG_INFO(Network,
+             "DIAG mode={} members={} rtt_ms min/avg/max={}/{}/{} rtt_var_max={} "
+             "up_holds={} up_hold_ms={} gaps={} gaps_unheld={} "
+             "proxy_pkts={} ldn_pkts={} proxy_B={} ldn_B={} bcast_sends={} "
+             "drops oversize/malformed/budget/unk_ip={}/{}/{}/{} "
+             "sizes <=512/513-1024/1025-1366/1367-1536={}/{}/{}/{} "
+             "since_last proxy/ldn/bcast={}/{}/{} proxy_B/ldn_B={}/{} "
+             "drops_over/mal/bud/unk={}/{}/{}/{}",
+             GetRelayMode().name, members_n, rtt_min, rtt_avg, rtt_max, rtt_var_max, all.holds,
+             all.hold_ms, all.gaps, all.gaps_unheld, total.proxy_packets, total.ldn_packets,
+             total.proxy_bytes, total.ldn_bytes, total.broadcast_sends, total.drop_oversize,
+             total.drop_malformed, total.drop_budget, total.drop_unknown_ip, relay_sizes[0],
+             relay_sizes[1], relay_sizes[2], relay_sizes[3], window.proxy_packets,
+             window.ldn_packets, window.broadcast_sends, window.proxy_bytes, window.ldn_bytes,
+             window.drop_oversize, window.drop_malformed, window.drop_budget,
+             window.drop_unknown_ip);
+    for (const auto& line : member_lines) {
+        LOG_INFO(Network, "{}", line);
+    }
+
+    // Only what the numbers show: the room cannot see game state, and in the unreliable modes it
+    // cannot see its own packets to members being lost either.
+    std::vector<std::string> advice;
+    if (members_n == 0) {
+        advice.emplace_back("no members; idle");
+    } else if (!game_active) {
+        advice.emplace_back("no game packets this window; nothing to measure");
+    } else {
+        if (window.drop_oversize > 0) {
+            advice.emplace_back("oversize drops: a member sent game packets over 1536 bytes");
+        }
+        if (most_held) {
+            const UplinkStats& stats = most_held->window;
+            advice.push_back(fmt::format(
+                "{}'s packets to the room were held {} times ({}ms, longest {}ms): their uplink "
+                "is losing packets, and as Eden sends reliably each loss freezes what they send "
+                "to everyone (wired Ethernet helps)",
+                most_held->nickname, stats.holds, stats.hold_ms, stats.hold_max_ms));
+        }
+        if (most_unheld) {
+            const UplinkStats& stats = most_unheld->window;
+            advice.push_back(fmt::format(
+                "{} sent no game packets for over {}ms {} times with no loss to explain it: their "
+                "PC or emulation stalled (shader compiles, frame drops)",
+                most_unheld->nickname, GapMinimum.count(), stats.gaps_unheld));
+        }
+        if (window.drop_unknown_ip > 0) {
+            advice.emplace_back("unknown-IP drops: packets to a fake IP no member has (a join "
+                                "race or a stale target)");
+        }
+        if (reliable_mode) {
+            advice.emplace_back("reliable mode: one packet lost on the way to a member holds "
+                                "every sender's packets to them; unsequenced avoids that");
+        }
+        if (advice.empty()) {
+            advice.push_back(fmt::format("no stalls the room can see (no holds, no gaps over "
+                                         "{}ms)",
+                                         GapMinimum.count()));
+        }
+        if (!reliable_mode) {
+            advice.emplace_back("the room cannot see loss on its own packets to members (nothing "
+                                "acknowledges them) or anything in the game");
+        }
+    }
+    LOG_INFO(Network, "DIAG advice: {}", fmt::join(advice, "; "));
+
+    for (auto& [peer, snapshot] : peer_snapshots) {
+        snapshot.window = {};
+    }
+}
+
 // Room
 Room::Room() : room_impl{std::make_unique<RoomImpl>()} {}
 
