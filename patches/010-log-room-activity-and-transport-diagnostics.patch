+void Room::RoomImpl::LogSessionStats(ENetPeer* client, const std::string& ip,
+                                     const std::string& nickname) const {
+    PeerSnapshot snapshot{};
+    std::string duration = "?s";
+    if (const auto it = peer_snapshots.find(client); it != peer_snapshots.end()) {
+        snapshot = it->second;
+        const auto secs = std::chrono::duration_cast<std::chrono::seconds>(
+                              std::chrono::steady_clock::now() - snapshot.join_time)
+                              .count();
+        duration = secs >= 60 ? fmt::format("{}m{}s", secs / 60, secs % 60)
+                              : fmt::format("{}s", secs);
+    }
+    LOG_INFO(Network,
+             "[{}] {} session join_rtt {}ms last_rtt {}ms peak_rtt {}ms "
+             "last_loss {:.2f}% peak_loss {:.2f}% duration {}",
+             ip, nickname, snapshot.join_rtt, snapshot.last_rtt, snapshot.peak_rtt,
+             LossPercent(snapshot.last_loss), LossPercent(snapshot.peak_loss), duration);
+}
+
+void Room::RoomImpl::MaybeLogRelayDiagnostics() {
+    if (diag_interval_sec == 0) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (!diag_started) {
+        diag_started = true;
+        diag_window_start = now;
+        LOG_INFO(Network,
+                 "DIAG boot mode={} unknown_ip={} timeout_ms={}/{} ping_ms={} "
+                 "diag_interval_s={} budget_kbps={} "
+                 "(server cannot detect game desync; DIAG reports transport only)",
+                 GetRelayMode().name, UnknownIpFallbackEnabled() ? "broadcast" : "drop",
+                 peer_timeout_min_ms, peer_timeout_max_ms, ping_interval_ms, diag_interval_sec,
+                 relay_budget_bytes / 1024);
+    }
+    if (now - diag_window_start < std::chrono::seconds(diag_interval_sec)) {
+        return;
+    }
+    diag_window_start = now;
+
+    const RelayCounters& total = relay_counters;
+    const RelayCounters window = total - relay_counters_last;
+    relay_counters_last = total;
+    const bool game_active = window.proxy_packets + window.ldn_packets > 0;
+
+    // Sample every member's RTT and loss, for this report and for its STAT line.
+    u32 members_n = 0;
+    u32 rtt_min = 0;
+    u32 rtt_max = 0;
+    u64 rtt_sum = 0;
+    u32 loss_max = 0;
+    u64 loss_sum = 0;
+    u32 rtt_var_max = 0;
+    {
+        std::shared_lock lock(member_mutex);
+        members_n = static_cast<u32>(members.size());
+        for (const auto& member : members) {
+            const u32 rtt = member.peer->roundTripTime;
+            const u32 loss = member.peer->packetLoss;
+            rtt_min = &member == &members.front() ? rtt : (std::min)(rtt_min, rtt);
+            rtt_max = (std::max)(rtt_max, rtt);
+            rtt_sum += rtt;
+            loss_sum += loss;
+            loss_max = (std::max)(loss_max, loss);
+            rtt_var_max = (std::max)(rtt_var_max, member.peer->roundTripTimeVariance);
+
+            if (const auto it = peer_snapshots.find(member.peer); it != peer_snapshots.end()) {
+                auto& snapshot = it->second;
+                snapshot.last_rtt = rtt;
+                snapshot.peak_rtt = (std::max)(snapshot.peak_rtt, rtt);
+                snapshot.last_loss = loss;
+                snapshot.peak_loss = (std::max)(snapshot.peak_loss, loss);
+            }
+        }
+    }
+    const u32 rtt_avg = members_n > 0 ? static_cast<u32>(rtt_sum / members_n) : 0;
+    const double loss_avg_pct =
+        members_n > 0 ? LossPercent(static_cast<double>(loss_sum) / members_n) : 0.0;
+    const double loss_max_pct = LossPercent(loss_max);
+
+    LOG_INFO(Network,
+             "DIAG mode={} members={} rtt_ms min/avg/max={}/{}/{} rtt_var_max={} "
+             "loss_pct avg/max={:.2f}/{:.2f} "
+             "proxy_pkts={} ldn_pkts={} proxy_B={} ldn_B={} bcast_sends={} "
+             "drops oversize/malformed/budget/unk_ip={}/{}/{}/{} "
+             "sizes <=512/513-1024/1025-1366/1367-1536={}/{}/{}/{} "
+             "since_last proxy/ldn/bcast={}/{}/{} proxy_B/ldn_B={}/{} "
+             "drops_over/mal/bud/unk={}/{}/{}/{}",
+             GetRelayMode().name, members_n, rtt_min, rtt_avg, rtt_max, rtt_var_max, loss_avg_pct,
+             loss_max_pct, total.proxy_packets, total.ldn_packets, total.proxy_bytes,
+             total.ldn_bytes, total.broadcast_sends, total.drop_oversize, total.drop_malformed,
+             total.drop_budget, total.drop_unknown_ip, relay_sizes[0], relay_sizes[1],
+             relay_sizes[2], relay_sizes[3], window.proxy_packets, window.ldn_packets,
+             window.broadcast_sends, window.proxy_bytes, window.ldn_bytes, window.drop_oversize,
+             window.drop_malformed, window.drop_budget, window.drop_unknown_ip);
+
+    // Transport only: the room cannot see game state. An idle room's RTT and loss come from
+    // control traffic, so they say nothing about gameplay.
+    std::string_view advice;
+    if (members_n == 0) {
+        advice = "no members; idle";
+    } else if (!game_active) {
+        advice = "idle (no relay traffic this window; RTT/loss are control-plane only — "
+                 "not gameplay; ignore lossy advice until proxy/ldn packets climb)";
+    } else if (window.drop_oversize > 0) {
+        advice = "oversize drops this window: investigate clients/caps before blaming relay mode";
+    } else if (loss_max_pct >= 2.0 || rtt_var_max >= 80) {
+        advice = "lossy/jittery path under active relay: prefer sequenced (not unsequenced); "
+                 "if still unstable try reliable; also tighten timeouts only if zombies linger";
+    } else if (loss_max_pct >= 0.5 || rtt_max >= 200) {
+        advice = "moderate WAN stress under active relay: keep sequenced; unsequenced risks "
+                 "reorder desync; if rubber-banding only, compare reliable vs sequenced offline";
+    } else if (window.drop_unknown_ip > 0) {
+        advice = "unknown-IP drops this window: fake-IP table miss (join race or stale target); "
+                 "if connect fails, briefly test UNKNOWN_IP=broadcast";
+    } else if (rtt_max < 80 && loss_max_pct < 0.25) {
+        advice = "transport looks clean under active relay: if races still desync, check client "
+                 "FPS/same Eden build/limit-speed (emulation) — relay mode changes unlikely to help";
+    } else {
+        advice = "mixed path under active relay: keep sequenced as default; collect client FPS "
+                 "logs alongside DIAG";
+    }
+    LOG_INFO(Network, "DIAG advice: {}", advice);
+}
+
 // Room
 Room::Room() : room_impl{std::make_unique<RoomImpl>()} {}
 
