+
+/// ENet's packet loss (ENET_PEER_PACKET_LOSS_SCALE units) as a percentage.
+double LossPercent(double loss) {
+    return 100.0 * loss / static_cast<double>(ENET_PEER_PACKET_LOSS_SCALE);
+}
+
+u32 Milliseconds(std::chrono::steady_clock::duration duration) {
+    return static_cast<u32>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(duration).count());
+}
+
+/// Whether ENet is holding reliable commands from the peer that arrived after one still missing
+/// (or the rest of a fragmented packet). They wait in the channel until the gap is filled.
+bool Held(const ENetPeer* peer) {
+    return peer->state == ENET_PEER_STATE_CONNECTED && peer->channelCount > 0 &&
+           !enet_list_empty(&peer->channels[0].incomingReliableCommands);
+}
