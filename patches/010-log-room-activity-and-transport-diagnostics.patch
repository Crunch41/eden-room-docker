+    /// What STAT reports when a member leaves. ENet resets a peer (RTT back to 500 ms, loss and
+    /// counters to 0) before it reports the disconnect, so the values are kept from the join and
+    /// from DIAG samples. Room thread only.
+    struct PeerSnapshot {
+        u32 join_rtt{500};
+        u32 last_rtt{500};
+        u32 peak_rtt{500};
+        u32 last_loss{0}; ///< In ENET_PEER_PACKET_LOSS_SCALE units
+        u32 peak_loss{0};
+        std::chrono::steady_clock::time_point join_time{};
+    };
+    std::unordered_map<ENetPeer*, PeerSnapshot> peer_snapshots;
+
+    /// Relay counters for DIAG (room thread only).
+    struct RelayCounters {
+        u64 proxy_packets{};
+        u64 ldn_packets{};
+        u64 proxy_bytes{};
+        u64 ldn_bytes{};
+        u64 broadcast_sends{};
+        u64 drop_oversize{};
+        u64 drop_malformed{};
+        u64 drop_budget{};
+        u64 drop_unknown_ip{};
+
+        RelayCounters operator-(const RelayCounters& o) const {
+            return {proxy_packets - o.proxy_packets,     ldn_packets - o.ldn_packets,
+                    proxy_bytes - o.proxy_bytes,         ldn_bytes - o.ldn_bytes,
+                    broadcast_sends - o.broadcast_sends, drop_oversize - o.drop_oversize,
+                    drop_malformed - o.drop_malformed,   drop_budget - o.drop_budget,
+                    drop_unknown_ip - o.drop_unknown_ip};
+        }
+    };
+    RelayCounters relay_counters;      ///< Since the room opened
+    RelayCounters relay_counters_last; ///< At the previous DIAG report
+    /// Relayed packets by size: up to 512, 513-1024, 1025-1366 (one ENet datagram) and
+    /// 1367-1536 bytes (fragmented).
+    std::array<u64, 4> relay_sizes{};
+
+    /// Seconds between DIAG reports (EDEN_ROOM_DIAG_INTERVAL_SEC, 0 = off).
+    const u32 diag_interval_sec = EnvNumber("EDEN_ROOM_DIAG_INTERVAL_SEC", 0, 0, 3600);
