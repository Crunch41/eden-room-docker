+    /// What the room can see of a member's game packets on their way to it. Eden clients send
+    /// everything reliably on one ENet channel, so when a datagram from a member is lost, ENet
+    /// holds everything the member sends after it until the client resends it: one RTO, about
+    /// 50 ms on a short route and 250 ms across the Pacific. The room sees that hold (and so the
+    /// member's uplink loss) in the channel's queue of held commands. A gap between a member's
+    /// game packets with no hold in it means the member sent nothing: their PC or emulation
+    /// stalled. Loss on the room's own unreliable packets to a member is invisible to the room:
+    /// nothing acknowledges them.
+    static constexpr auto HoldMinimum = std::chrono::milliseconds(10);
+    static constexpr auto GapMinimum = std::chrono::milliseconds(100);
+    static constexpr auto GapMaximum = std::chrono::seconds(5); ///< Longer: idle, not a stall
+    static constexpr auto BurstSpacing = std::chrono::milliseconds(2);
+    struct UplinkStats {
+        u64 packets{};     ///< Game (proxy) packets relayed
+        u32 holds{};       ///< Times the member's stream was held for a resend
+        u64 hold_ms{};     ///< Time held
+        u32 hold_max_ms{}; ///< Longest hold
+        u32 gaps{};        ///< Gaps between game packets of GapMinimum to GapMaximum
+        u32 gaps_unheld{}; ///< Gaps with no hold in them: the member sent nothing
+        u32 gap_max_ms{};  ///< Longest gap
+        u32 burst_max{};   ///< Most game packets in a row less than BurstSpacing apart
+
+        std::string Describe() const {
+            return fmt::format("game_pkts {} up_holds {} ({}ms, max {}ms) gaps {} (max {}ms, "
+                               "{} unheld) burst_max {}",
+                               packets, holds, hold_ms, hold_max_ms, gaps, gap_max_ms,
+                               gaps_unheld, burst_max);
+        }
+    };
+
+    /// Per member: STAT's figures, and what DIAG reports. ENet resets a peer (RTT back to
+    /// 500 ms) before it reports the disconnect, so RTT is kept from the join and from DIAG
+    /// samples. Room thread only.
+    struct PeerSnapshot {
+        u32 join_rtt{500};
+        u32 last_rtt{500};
+        u32 peak_rtt{500};
+        std::chrono::steady_clock::time_point join_time{};
+        std::string ip;
+        std::string nickname;
