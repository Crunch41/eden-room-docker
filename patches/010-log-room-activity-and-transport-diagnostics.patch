+        bool held_since_packet{false};
+        std::optional<std::chrono::steady_clock::time_point> last_packet;
+        u32 burst{0};
+
+        template <typename F>
+        void Record(F&& update) {
+            update(session);
+            update(window);
+        }
+    };
+    std::unordered_map<ENetPeer*, PeerSnapshot> peer_snapshots;
+
+    /// Relay counters for DIAG (room thread only).
