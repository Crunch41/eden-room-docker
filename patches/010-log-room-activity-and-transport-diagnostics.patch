-    auto const time_fractional = uint32_t(entry.timestamp.count() % 1000000);
+    // Wall-clock time, a fixed label for room activity, and the message; warnings and errors keep
+    // their class and level.
+    const auto time_now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+    std::tm local_time{};
+#ifdef _WIN32
+    localtime_s(&local_time, &time_now);
+#else
+    localtime_r(&time_now, &local_time);
+#endif
     auto const class_name = GetLogClassName(entry.log_class);
     auto const level_name = GetLevelName(entry.log_level);
-    return fmt::format("[{:4d}.{:06d}] {} <{}> {}:{}:{}: {}\n", time_seconds, time_fractional, class_name, level_name, entry.filename, entry.line_num, entry.function, entry.message);
+    const std::string_view function = entry.function ? entry.function : "";
+    std::string_view message(entry.message ? entry.message : "",
+                             entry.message ? entry.message_len : 0);
+    const auto contains = [&message](std::string_view text) {
+        return message.find(text) != std::string_view::npos;
+    };
+
+    const char* label = nullptr;
+    if (entry.log_level == Level::Info && std::strcmp(class_name, "Network") == 0) {
+        if (function == "SendStatusMessage" && contains("has joined.")) {
+            label = "JOIN ";
+        } else if (function == "SendStatusMessage" && contains("has left.")) {
+            label = "LEAVE";
+        } else if (function == "HandleChatPacket") {
+            label = "CHAT ";
+        } else if (function == "HandleGameInfoPacket" &&
+                   (contains(" is playing ") || contains(" is not playing"))) {
+            label = "GAME ";
+        } else if (function == "HandleJoinRequest" && contains("RTT")) {
+            label = "PING ";
+        } else if (function == "LogSessionStats") {
+            label = "STAT ";
+        } else if (message.starts_with("DIAG ")) {
+            label = "DIAG ";
+            message.remove_prefix(5);
+        }
+    }
+
+    const auto time = fmt::format("[{:02d}:{:02d}:{:02d}]", local_time.tm_hour, local_time.tm_min,
+                                  local_time.tm_sec);
+    if (label) {
+        return fmt::format("{} {} | {}\n", time, label, message);
+    }
+    if (entry.log_level >= Level::Warning) {
+        return fmt::format("{} {} <{}> {}\n", time, class_name, level_name, message);
+    }
+    return fmt::format("{} {}\n", time, message);
 }
 
