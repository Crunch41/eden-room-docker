+        u64 ldn_bytes{};
+        u64 broadcast_sends{};
+        u64 drop_oversize{};
+        u64 drop_malformed{};
+        u64 drop_budget{};
+        u64 drop_unknown_ip{};
+
+        RelayCounters operator-(const RelayCounters& o) const {
+            return {proxy_packets - o.proxy_packets,     ldn_packets - o.ldn_packets,
+                    proxy_bytes - o.proxy_bytes,         ldn_bytes - o.ldn_bytes,
+                    broadcast_sends - o.broadcast_sends, drop_oversize - o.drop_oversize,
+                    drop_malformed - o.drop_malformed,   drop_budget - o.drop_budget,
+                    drop_unknown_ip - o.drop_unknown_ip};
