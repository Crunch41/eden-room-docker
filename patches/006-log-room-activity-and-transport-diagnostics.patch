+    /// What the room can see of a member's game packets on their way to it. Eden clients send
+    /// everything reliably on one ENet channel, so when a datagram from a member is lost, ENet
+    /// holds everything the member sends after it until the client resends it: one RTO, about
+    /// 50 ms on a short route and 250 ms across the Pacific. The room sees that hold (and so the
+    /// member's uplink loss) in the channel's queue of held commands. A gap between a member's
+    /// game packets with no hold in it means the member sent nothing: their PC or emulation
+    /// stalled. Loss on the room's own unreliable packets to a member is invisible to the room:
+    /// nothing acknowledges them.
+    static constexpr auto HoldMinimum = std::chrono::milliseconds(10);
+    static constexpr auto GapMinimum = std::chrono::milliseconds(100);
+    static constexpr auto GapMaximum = std::chrono::seconds(5); ///< Longer: idle, not a stall
+    static constexpr auto BurstSpacing = std::chrono::milliseconds(2);
+    struct UplinkStats {
+        u64 packets{};     ///< Game (proxy) packets relayed
+        u32 holds{};       ///< Times the member's stream was held for a resend
+        u64 hold_ms{};     ///< Time held
+        u32 hold_max_ms{}; ///< Longest hold
+        u32 gaps{};        ///< Gaps between game packets of GapMinimum to GapMaximum
+        u32 gaps_unheld{}; ///< Gaps with no hold in them: the member sent nothing
+        u32 gap_max_ms{};  ///< Longest gap
+        u32 burst_max{};   ///< Most game packets in a row less than BurstSpacing apart
+
+        std::string Describe() const {
+            return std::format("game_pkts {} up_holds {} ({}ms, max {}ms) gaps {} (max {}ms, "
+                               "{} unheld) burst_max {}",
+                               packets, holds, hold_ms, hold_max_ms, gaps, gap_max_ms,
+                               gaps_unheld, burst_max);
+        }
+
+        /// Fewer game packets than this in a session: the member never really played (a lobby
+        /// probe, or a game's network scan).
+        static constexpr u64 PlayedMinimum = 100;
+
+        /// How the member's connection to the room felt, from its holds (above) over a session
+        /// of `secs` seconds: laggy when it was held 1% of the time or 3 times a minute, lag
+        /// spikes when held once a minute or once for half a second, good otherwise. Set from
+        /// the STAT lines of a public room's real sessions. Gaps are left out: they are the
+        /// member's PC or game, not the connection. Empty when there is too little to go on.
+        std::string_view Rating(s64 secs) const {
+            if (packets < PlayedMinimum || secs < 60) {
+                return {};
+            }
+            const double per_minute = holds * 60.0 / static_cast<double>(secs);
+            const double held_share = static_cast<double>(hold_ms) / (secs * 1000.0);
+            if (held_share >= 0.01 || per_minute >= 3.0) {
+                return "laggy connection";
+            }
+            if (per_minute >= 1.0 || hold_max_ms >= 500) {
+                return "some lag spikes";
+            }
+            return "connection good";
+        }
+    };
+
+    /// Per member: STAT's figures, and what DIAG reports. ENet resets a peer (RTT back to
+    /// 500 ms) before it reports the disconnect, so RTT is kept from the join and from DIAG
+    /// samples. Room thread only.
+    struct PeerSnapshot {
+        u32 join_rtt{500};
+        u32 last_rtt{500};
+        u32 peak_rtt{500};
+        std::chrono::steady_clock::time_point join_time{};
+        std::string ip;
+        std::string nickname;
+        std::string game; ///< The last game the member played, for the LEAVE line
+        std::chrono::system_clock::time_point joined{}; ///< Wall-clock join, for the sessions file
+        std::string ended{"left"}; ///< How the session ended: left, kicked, banned, room stopped
+        /// Time in each game reported this session, in the order first played; the current
+        /// game runs from game_since.
+        std::vector<std::pair<std::string, s64>> games;
+        std::string current_game;
+        std::chrono::steady_clock::time_point game_since{};
+
+        /// Adds the time since game_since to the current game, then switches to `name`.
+        void SwitchGame(const std::string& name, std::chrono::steady_clock::time_point now) {
+            if (!current_game.empty()) {
+                const s64 secs =
+                    std::chrono::duration_cast<std::chrono::seconds>(now - game_since).count();
+                const auto entry = std::find_if(games.begin(), games.end(), [this](const auto& g) {
+                    return g.first == current_game;
+                });
+                if (entry != games.end()) {
+                    entry->second += secs;
+                } else {
+                    games.emplace_back(current_game, secs);
+                }
+            }
+            current_game = name;
+            game_since = now;
+        }
+
+        UplinkStats session; ///< Since the join, for STAT
+        UplinkStats window;  ///< Since the last DIAG report
+        std::optional<std::chrono::steady_clock::time_point> hold_start;
+        bool held_since_packet{false};
+        std::optional<std::chrono::steady_clock::time_point> last_packet;
+        u32 burst{0};
+
+        template <typename F>
+        void Record(F&& update) {
+            update(session);
+            update(window);
+        }
+    };
+    std::unordered_map<ENetPeer*, PeerSnapshot> peer_snapshots;
+
+    /// Relay counters for DIAG (room thread only).
+    struct RelayCounters {
+        u64 proxy_packets{};
+        u64 ldn_packets{};
+        u64 proxy_bytes{};
+        u64 ldn_bytes{};
+        u64 broadcast_sends{};
+        u64 drop_oversize{};
+        u64 drop_malformed{};
+        u64 drop_budget{};
+        u64 drop_unknown_ip{};
+
+        RelayCounters operator-(const RelayCounters& o) const {
+            return {proxy_packets - o.proxy_packets,     ldn_packets - o.ldn_packets,
+                    proxy_bytes - o.proxy_bytes,         ldn_bytes - o.ldn_bytes,
+                    broadcast_sends - o.broadcast_sends, drop_oversize - o.drop_oversize,
+                    drop_malformed - o.drop_malformed,   drop_budget - o.drop_budget,
+                    drop_unknown_ip - o.drop_unknown_ip};
+        }
+    };
+    RelayCounters relay_counters;      ///< Since the room opened
+    RelayCounters relay_counters_last; ///< At the previous DIAG report
+    /// Relayed packets by size: up to 512, 513-1024, 1025-1366 (one ENet datagram) and
+    /// 1367-1536 bytes (fragmented).
+    std::array<u64, 4> relay_sizes{};
+
+    std::chrono::steady_clock::time_point diag_window_start{};
+    bool diag_started = false;
+
     RoomImpl() {}
 
     /// Thread that receives and dispatches network packets
