+
+/// ENet's packet loss (ENET_PEER_PACKET_LOSS_SCALE units) as a percentage.
+double LossPercent(double loss) {
+    return 100.0 * loss / static_cast<double>(ENET_PEER_PACKET_LOSS_SCALE);
+}
+
+/// `text` as a JSON string, quotes included.
+std::string JsonString(std::string_view text) {
+    std::string out = "\"";
+    for (const char c : text) {
+        switch (c) {
+        case '"':
+            out += "\\\"";
+            break;
+        case '\\':
+            out += "\\\\";
+            break;
+        case '\n':
+            out += "\\n";
+            break;
+        case '\r':
+            out += "\\r";
+            break;
+        case '\t':
+            out += "\\t";
+            break;
+        default:
+            if (static_cast<unsigned char>(c) < 0x20) {
+                out += std::format("\\u{:04x}", static_cast<unsigned>(c));
+            } else {
+                out += c;
+            }
+        }
+    }
+    return out + "\"";
+}
+
+/// A UTC time for the sessions file: 2026-11-23T02:26:52Z.
+std::string JsonTime(std::chrono::system_clock::time_point time) {
+    return std::format("\"{:%FT%TZ}\"", std::chrono::floor<std::chrono::seconds>(time));
+}
+
+/// A session length for the log: 45s, 36m44s, 6h27m.
+std::string FormatDuration(std::chrono::steady_clock::duration duration) {
+    const auto secs = std::chrono::duration_cast<std::chrono::seconds>(duration).count();
+    if (secs < 60) {
+        return std::format("{}s", secs);
+    }
+    if (secs < 3600) {
+        return std::format("{}m{:02d}s", secs / 60, secs % 60);
+    }
+    return std::format("{}h{:02d}m", secs / 3600, (secs % 3600) / 60);
+}
+
+u32 Milliseconds(std::chrono::steady_clock::duration duration) {
+    return static_cast<u32>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(duration).count());
+}
+
+/// Whether ENet is holding reliable commands from the peer that arrived after one still missing
+/// (or the rest of a fragmented packet). They wait in the channel until the gap is filled.
+bool Held(const ENetPeer* peer) {
+    return peer->state == ENET_PEER_STATE_CONNECTED && peer->channelCount > 0 &&
+           !enet_list_empty(&peer->channels[0].incomingReliableCommands);
+}
 } // namespace
 
