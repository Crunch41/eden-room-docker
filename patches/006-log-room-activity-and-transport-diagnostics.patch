+/// Room activity (src/network/room.cpp) logs these as the first word of a Network Info message:
+/// joins, leaves, chat, games, join RTT, a member's session summary and diagnostics.
+constexpr std::string_view ActivityTags[] = {"JOIN", "LEAVE", "KICK", "BAN",
+                                             "CHAT", "GAME",  "STAT", "DIAG"};
+
 // Some IDEs prefer <file>:<line> instead, so let's just do that :)
 std::string FormatLogMessage(const Entry& entry) noexcept {
     if (!entry.filename) return "";
     // Local wall-clock time (TZ) and the message, without source location; warnings and errors
-    // keep their class and level.
+    // keep their class and level. Room activity starts with a tag (see ActivityTags), shown as a
+    // fixed-width label.
     const auto time_now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
     std::tm local_time{};
 #ifdef _WIN32
@@ -101,10 +107,19 @@ std::string FormatLogMessage(const Entry& entry) noexcept {
 #endif
     auto const class_name = GetLogClassName(entry.log_class);
     auto const level_name = GetLevelName(entry.log_level);
-    const std::string_view message(entry.message ? entry.message : "",
-                                   entry.message ? entry.message_len : 0);
+    std::string_view message(entry.message ? entry.message : "",
+                             entry.message ? entry.message_len : 0);
     const auto time = std::format("[{:02d}:{:02d}:{:02d}]", local_time.tm_hour, local_time.tm_min,
                                   local_time.tm_sec);
+    if (entry.log_level == Level::Info && entry.log_class == Class::Network) {
+        for (const std::string_view tag : ActivityTags) {
+            if (message.size() > tag.size() && message.starts_with(tag) &&
+                message[tag.size()] == ' ') {
+                message.remove_prefix(tag.size() + 1);
+                return std::format("{} {:<5}  {}\n", time, tag, message);
+            }
+        }
+    }
     if (entry.log_level >= Level::Warning) {
         return std::format("{} {} <{}> {}\n", time, class_name, level_name, message);
     }
