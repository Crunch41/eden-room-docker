     return ip[0] == 10 || (ip[0] == 172 && ip[1] >= 16 && ip[1] <= 31) ||
            (ip[0] == 192 && ip[1] == 168) || ip[0] == 127;
 }
+
+/// Delivery of relayed proxy/LDN game packets, from EDEN_ROOM_RELAY_MODE:
+///   reliable    - upstream's ENET_PACKET_FLAG_RELIABLE: everything is retransmitted and kept in
+///                 order, so one lost packet holds up all that follow (head-of-line blocking).
+///   sequenced   - unreliable but sequenced: nothing is retransmitted, late packets are dropped.
+///   unsequenced - unreliable and unordered. Used when neither variable is set.
+/// The legacy EDEN_ROOM_RELAY_RELIABLE=1 selects reliable when EDEN_ROOM_RELAY_MODE is unset.
+/// The unreliable modes add ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT: without it ENet silently sends
+/// packets above its fragment size (about 1366 bytes) as reliable fragments.
+struct RelayMode {
+    const char* name;
+    enet_uint32 flags;
+};
+
+const RelayMode& GetRelayMode() {
+    static const RelayMode relay_mode = [] {
+        constexpr RelayMode reliable{"reliable", ENET_PACKET_FLAG_RELIABLE};
+        constexpr RelayMode sequenced{"sequenced", ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+        constexpr RelayMode unsequenced{
+            "unsequenced", ENET_PACKET_FLAG_UNSEQUENCED | ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+        const char* value = std::getenv("EDEN_ROOM_RELAY_MODE");
+        if (value == nullptr || *value == '\0') {
+            const char* legacy = std::getenv("EDEN_ROOM_RELAY_RELIABLE");
+            return legacy != nullptr && std::strcmp(legacy, "1") == 0 ? reliable : unsequenced;
+        }
+        for (const RelayMode& candidate : {reliable, sequenced, unsequenced}) {
+            if (std::strcmp(value, candidate.name) == 0) {
+                return candidate;
+            }
+        }
+        LOG_WARNING(Network, "Unknown EDEN_ROOM_RELAY_MODE '{}', using unsequenced", value);
+        return unsequenced;
+    }();
+    return relay_mode;
+}
 } // namespace
 
