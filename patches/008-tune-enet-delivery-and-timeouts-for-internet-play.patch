 }
 
+void Room::RoomImpl::TunePeer(ENetPeer* client) {
+    enet_peer_timeout(client, ENET_PEER_TIMEOUT_LIMIT, peer_timeout_min_ms, peer_timeout_max_ms);
+    enet_peer_ping_interval(client, ping_interval_ms);
+    // ENet lowers a peer's packet throttle when its RTT rises and then randomly drops unreliable
+    // packets, game packets included. A deceleration of 0 keeps the throttle at its maximum.
+    enet_peer_throttle_configure(client, 1000, ENET_PEER_PACKET_THROTTLE_ACCELERATION, 0);
+}
