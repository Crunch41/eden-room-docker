 src/network/room.cpp | 82 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 79 insertions(+), 3 deletions(-)

diff --git a/src/network/room.cpp b/src/network/room.cpp
index 82b540aee6b654ad6523272b56905b0ba15e72dc..83fc6a349616954f482d97f7edaa6ef3de63f73b 100644
--- a/src/network/room.cpp
+++ b/src/network/room.cpp
@@ -7,6 +7,7 @@
 #include <atomic>
 #include <chrono>
 #include <cstdlib>
+#include <cstring>
 #include <exception>
 #include <iomanip>
 #include <mutex>
@@ -53,6 +54,46 @@ bool IsLocalAddress(const ENetAddress& address) {
     return ip[0] == 10 || (ip[0] == 172 && ip[1] >= 16 && ip[1] <= 31) ||
            (ip[0] == 192 && ip[1] == 168) || ip[0] == 127;
 }
+
+/// Delivery of relayed game data (UDP proxy packets), from EDEN_ROOM_RELAY_MODE:
+///   reliable    - upstream's ENET_PACKET_FLAG_RELIABLE: everything is retransmitted and kept in
+///                 order, so one lost packet holds up all that follow (head-of-line blocking),
+///                 from every sender to that member, since they share one channel.
+///   sequenced   - unreliable but sequenced: nothing is retransmitted, a packet that arrives after
+///                 a newer one (from any sender) is dropped, and packets wait behind any lost
+///                 reliable message on the channel (chat, joins, room information, LDN).
+///   unsequenced - unreliable and unordered: delivered as it arrives. Used when neither variable
+///                 is set.
+/// The legacy EDEN_ROOM_RELAY_RELIABLE=1 selects reliable when EDEN_ROOM_RELAY_MODE is unset.
+/// The unreliable modes add ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT: without it ENet silently sends
+/// packets above its fragment size (about 1366 bytes) as reliable fragments.
+/// LDN packets and TCP proxy packets are relayed reliably in every mode (see their handlers).
+struct RelayMode {
+    const char* name;
+    enet_uint32 flags;
+};
+
+const RelayMode& GetRelayMode() {
+    static const RelayMode relay_mode = [] {
+        constexpr RelayMode reliable{"reliable", ENET_PACKET_FLAG_RELIABLE};
+        constexpr RelayMode sequenced{"sequenced", ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+        constexpr RelayMode unsequenced{
+            "unsequenced", ENET_PACKET_FLAG_UNSEQUENCED | ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+        const char* value = std::getenv("EDEN_ROOM_RELAY_MODE");
+        if (value == nullptr || *value == '\0') {
+            const char* legacy = std::getenv("EDEN_ROOM_RELAY_RELIABLE");
+            return legacy != nullptr && std::strcmp(legacy, "1") == 0 ? reliable : unsequenced;
+        }
+        for (const RelayMode& candidate : {reliable, sequenced, unsequenced}) {
+            if (std::strcmp(value, candidate.name) == 0) {
+                return candidate;
+            }
+        }
+        LOG_WARNING(Network, "Unknown EDEN_ROOM_RELAY_MODE '{}', using unsequenced", value);
+        return unsequenced;
+    }();
+    return relay_mode;
+}
 } // namespace
 
 class Room::RoomImpl {
@@ -97,6 +138,12 @@ public:
     static constexpr auto JoinRateLimit = std::chrono::seconds(1);
     static constexpr auto JoinRateLimitPruneAge = std::chrono::minutes(10);
 
+    /// ENet peer timing (EDEN_ROOM_PEER_TIMEOUT_MIN/MAX, EDEN_ROOM_PING_INTERVAL), in ms.
+    const u32 peer_timeout_min_ms = EnvNumber("EDEN_ROOM_PEER_TIMEOUT_MIN", 12000, 1, 3600000);
+    const u32 peer_timeout_max_ms = (std::max)(
+        peer_timeout_min_ms, EnvNumber("EDEN_ROOM_PEER_TIMEOUT_MAX", 60000, 1, 3600000));
+    const u32 ping_interval_ms = EnvNumber("EDEN_ROOM_PING_INTERVAL", 100, 1, 3600000);
+
     RoomImpl() {}
 
     /// Thread that receives and dispatches network packets
@@ -288,6 +335,12 @@ public:
      * @return false (after logging why) when the packet must be dropped
      */
     bool AcceptRelayPacket(const ENetEvent* event, std::size_t header_size, const char* kind);
+
+    /**
+     * Applies the room's ENet tuning to a peer that has just joined: peer timeouts and ping
+     * interval, and a packet throttle that stays at 100%.
+     */
+    void TunePeer(ENetPeer* client);
 };
 
 // RoomImpl
@@ -793,6 +846,7 @@ void Room::RoomImpl::SendJoinSuccess(ENetPeer* client, IPv4Address fake_ip) {
     ENetPacket* enet_packet =
         enet_packet_create(packet.GetData(), packet.GetDataSize(), ENET_PACKET_FLAG_RELIABLE);
     enet_peer_send(client, 0, enet_packet);
+    TunePeer(client);
     enet_host_flush(server);
 }
 
@@ -803,9 +857,21 @@ void Room::RoomImpl::SendJoinSuccessAsMod(ENetPeer* client, IPv4Address fake_ip)
     ENetPacket* enet_packet =
         enet_packet_create(packet.GetData(), packet.GetDataSize(), ENET_PACKET_FLAG_RELIABLE);
     enet_peer_send(client, 0, enet_packet);
+    TunePeer(client);
     enet_host_flush(server);
 }
 
+void Room::RoomImpl::TunePeer(ENetPeer* client) {
+    enet_peer_timeout(client, ENET_PEER_TIMEOUT_LIMIT, peer_timeout_min_ms, peer_timeout_max_ms);
+    enet_peer_ping_interval(client, ping_interval_ms);
+    // ENet lowers a peer's packet throttle when its RTT rises. The throttle scales the reliable
+    // send window (bytes in flight) and, below its maximum, drops unreliable packets at random,
+    // game packets included. A deceleration of 0 keeps it at its maximum. ENet sends the setting
+    // to the client too, which applies it to its own peer for the room, so the client's reliable
+    // uplink window does not shrink either.
+    enet_peer_throttle_configure(client, 1000, ENET_PEER_PACKET_THROTTLE_ACCELERATION, 0);
+}
+
 void Room::RoomImpl::SendUserKicked(ENetPeer* client) {
     Packet packet;
     packet.Write(static_cast<u8>(IdHostKicked));
@@ -1015,15 +1081,21 @@ void Room::RoomImpl::HandleProxyPacket(const ENetEvent* event) {
     in_packet.Read(remote_ip);          // IP
     in_packet.IgnoreBytes(sizeof(u16)); // Port
 
-    in_packet.IgnoreBytes(sizeof(u8)); // Protocol
+    u8 protocol;
+    in_packet.Read(protocol); // Protocol
 
     bool broadcast;
     in_packet.Read(broadcast); // Broadcast
 
+    // Game data is UDP and takes the relay mode. A TCP stream breaks if any of it is lost or
+    // reordered, so TCP proxy packets stay reliable.
+    const enet_uint32 flags = protocol == static_cast<u8>(Protocol::TCP)
+                                  ? static_cast<enet_uint32>(ENET_PACKET_FLAG_RELIABLE)
+                                  : GetRelayMode().flags;
     Packet out_packet;
     out_packet.Append(event->packet->data, event->packet->dataLength);
-    ENetPacket* enet_packet = enet_packet_create(out_packet.GetData(), out_packet.GetDataSize(),
-                                                 ENET_PACKET_FLAG_RELIABLE);
+    ENetPacket* enet_packet =
+        enet_packet_create(out_packet.GetData(), out_packet.GetDataSize(), flags);
 
     const auto& destination_address = remote_ip;
     if (broadcast) { // Send the data to everyone except the sender
@@ -1081,6 +1153,10 @@ void Room::RoomImpl::HandleLdnPacket(const ENetEvent* event) {
     bool broadcast;
     in_packet.Read(broadcast); // Broadcast
 
+    // LDN packets are the session's control messages (LDNPacketType: Scan, ScanResp, Connect,
+    // SyncNetwork, Disconnect, DestroyNetwork); game data travels as proxy packets. Clients send
+    // Connect, ScanResp and SyncNetwork once and never retry them, so a lost one fails a join or
+    // a scan: they are relayed reliably whatever the relay mode.
     Packet out_packet;
     out_packet.Append(event->packet->data, event->packet->dataLength);
     ENetPacket* enet_packet = enet_packet_create(out_packet.GetData(), out_packet.GetDataSize(),
