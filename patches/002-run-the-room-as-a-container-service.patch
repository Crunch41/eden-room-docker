@@ -347,6 +338,11 @@ struct LogcatBackend : public Backend {
 };
 #endif
 
+/// @brief Set while this thread is inside a backend. A backend that fails logs the failure (a
+/// full disk makes IOFile::Flush log an error), which would come back into ForEachBackend on the
+/// same thread while it holds backend_mutex. One flag for every ForEachBackend instantiation.
+thread_local bool in_backend = false;
+
 /// @brief Static state as a singleton.
 struct Impl {
     // Well, I mean it's the default constructor!
@@ -354,6 +350,17 @@ struct Impl {
 
     template<typename F>
     void ForEachBackend(F&& lambda) noexcept {
+        // Every thread logs in place; the backends (the file backend's byte count, its enabled
+        // flag) are not thread-safe on their own.
+        // A message logged by a backend while it writes (its own failure) is dropped: waiting for
+        // backend_mutex here would deadlock this thread, and the room would hang.
+        if (in_backend)
+            return;
+        in_backend = true;
+        struct Leave {
+            ~Leave() { in_backend = false; }
+        } leave;
+        std::scoped_lock lock{backend_mutex};
         lambda(static_cast<Backend&>(color_console_backend));
 #ifndef __OPENORBIS__
         if (file_backend)
@@ -367,6 +374,7 @@ struct Impl {
 #endif
     }
 
+    std::mutex backend_mutex;
     Filter filter;
     ColorConsoleBackend color_console_backend{};
 #ifndef __OPENORBIS__
