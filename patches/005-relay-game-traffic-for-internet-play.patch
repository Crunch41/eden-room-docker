@@ -59,6 +59,40 @@ bool IsLocalAddress(const ENetAddress& address) {
     return ip[0] == 10 || (ip[0] == 172 && ip[1] >= 16 && ip[1] <= 31) ||
            (ip[0] == 192 && ip[1] == 168) || ip[0] == 127;
 }
+
+/// Delivery of relayed game data (UDP proxy packets), from EDEN_ROOM_RELAY_MODE:
+///   reliable    - upstream's ENET_PACKET_FLAG_RELIABLE: everything is retransmitted and kept in
+///                 order, so one lost packet holds up all that follow (head-of-line blocking),
+///                 from every sender to that member, since they share one channel.
+///   sequenced   - unreliable but sequenced: nothing is retransmitted, a packet that arrives after
+///                 a newer one (from any sender) is dropped, and packets wait behind any lost
+///                 reliable message on the channel (chat, joins, room information, LDN).
+///   unsequenced - unreliable and unordered: delivered as it arrives. The default.
+/// The unreliable modes add ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT: without it ENet silently sends
+/// packets above its fragment size (about 1366 bytes) as reliable fragments.
+/// LDN packets and TCP proxy packets are relayed reliably in every mode (see their handlers).
+struct RelayMode {
+    const char* name;
+    enet_uint32 flags;
+};
+
+RelayMode ReadRelayMode() {
+    constexpr RelayMode reliable{"reliable", ENET_PACKET_FLAG_RELIABLE};
+    constexpr RelayMode sequenced{"sequenced", ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+    constexpr RelayMode unsequenced{
+        "unsequenced", ENET_PACKET_FLAG_UNSEQUENCED | ENET_PACKET_FLAG_UNRELIABLE_FRAGMENT};
+    const std::string value = EnvString("EDEN_ROOM_RELAY_MODE");
+    if (value.empty()) {
+        return unsequenced;
+    }
+    for (const RelayMode& candidate : {reliable, sequenced, unsequenced}) {
+        if (value == candidate.name) {
+            return candidate;
+        }
+    }
+    LOG_WARNING(Network, "Unknown EDEN_ROOM_RELAY_MODE '{}', using unsequenced", value);
+    return unsequenced;
+}
