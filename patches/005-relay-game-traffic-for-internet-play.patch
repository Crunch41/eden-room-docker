+bool Room::RoomImpl::SendToOthers(ENetPeer* sender, ENetPacket* packet) {
+    bool sent_packet = false;
+    for (const auto& member : members) {
+        if (member.peer != sender) {
+            sent_packet = true;
+            enet_peer_send(member.peer, 0, packet);
+        }
+    }
+    return sent_packet;
+}
