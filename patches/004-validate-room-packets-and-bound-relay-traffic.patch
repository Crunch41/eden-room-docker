+bool Room::RoomImpl::AcceptRelayPacket(const ENetEvent* event, std::size_t header_size,
+                                       const char* kind) {
+    const std::size_t size = event->packet->dataLength;
+    if (size < header_size) {
+        LOG_WARNING(Network, "Dropping malformed {} packet ({} bytes)", kind, size);
+        return false;
+    }
+    if (size > MaxRelayPayloadSize) {
+        LOG_WARNING(Network, "Dropping oversized {} packet ({} bytes)", kind, size);
+        return false;
+    }
+    if (relay_budget_bytes != 0) {
+        const auto now = std::chrono::steady_clock::now();
+        auto& budget = relay_budget[event->peer];
+        if (now - budget.window_start >= std::chrono::seconds(1)) {
+            budget.window_start = now;
+            budget.bytes = 0;
+        }
+        budget.bytes += size;
+        if (budget.bytes > relay_budget_bytes) {
+            if (budget.bytes - size <= relay_budget_bytes) {
+                LOG_WARNING(Network, "Relay budget exceeded, dropping {} packets for up to 1s",
+                            kind);
+            }
+            return false;
+        }
+    }
+    return true;
+}
