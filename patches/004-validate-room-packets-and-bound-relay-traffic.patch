 namespace Network {
 
+namespace {
+/// Reads a decimal environment variable. Unset or empty gives the fallback, and so does anything
+/// outside [min, max], with a warning.
+u32 EnvNumber(const char* name, u32 fallback, u32 min, u32 max) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return fallback;
+    }
+    char* end = nullptr;
+    const unsigned long parsed = std::strtoul(value, &end, 10);
+    if (end == value || *end != '\0' || parsed < min || parsed > max) {
+        LOG_WARNING(Network, "Ignoring invalid {} value '{}'", name, value);
+        return fallback;
+    }
+    return static_cast<u32>(parsed);
+}
+
+/// Largest proxy/LDN packet the room relays. Nintendo's Pia sends UDP payloads of up to about
+/// 1472 bytes and the room's header adds up to 21, so this passes real game traffic while
+/// bounding what one packet can make the room broadcast.
+constexpr std::size_t MaxRelayPayloadSize = 1536;
